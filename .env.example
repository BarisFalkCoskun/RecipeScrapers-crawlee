MONGODB_URI=mongodb://localhost:27017
DB_NAME=crawlee
# Production scheduling stays fail-closed until sources are promoted.
CRAWLEE_SCHEDULER_ALLOWED_STATES=cutover
# CRAWLEE_SCHEDULED_SOURCES=source_a,source_b
CRAWLEE_SCHEDULER_TIMEZONE=Europe/Copenhagen
CRAWLEE_SCRAPE_HOUR=1

# Independent sources run in separate worker processes; shared domains stay serialized.
CRAWLEE_SCHEDULER_WORKERS=2
CRAWLEE_HEALTH_MAX_AGE_HOURS=36
