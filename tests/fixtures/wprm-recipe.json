      "instructions": [
        {
          "instructions": [
            {
              "uid": 0,
              "name": "",
              "text": "Let the butter sit at room temperature until it is soft enough to mash with a fork, but not melted.",
              "image": 0,
              "ingredients": []
            },
            {
              "uid": 1,
              "name": "",
              "text": "Add the softened butter to a bowl with the prepared horseradish, parsley, chives, Dijon, lemon juice, lemon zest, garlic, Worcestershire, smoked paprika, salt, pepper, red pepper flakes, and cayenne if using.",
              "image": 0,
              "ingredients": []
            },
            {
              "uid": 2,
              "name": "",
              "text": "Mix everything together with a fork or rubber spatula until the herbs and seasonings are evenly distributed through the butter. Scrape the sides of the bowl so there are no plain butter pockets.",
              "image": 0,
              "ingredients": []
            },
            {
              "uid": 3,
              "name": "",
              "text": "Taste a small amount and adjust if needed: more salt for depth, more lemon for brightness, more red pepper flakes or cayenne for heat, or a little extra horseradish if you want it sharper.",
              "image": 0,
              "ingredients": []
            },
            {
              "uid": 4,
              "name": "",
              "text": "Spoon the butter onto a sheet of parchment paper or plastic wrap. Roll it into a log, twist the ends, and chill until firm, about 1 hour.",
              "image": 0,
              "ingredients": []
            },
            {
              "uid": 5,
              "name": "",
              "text": "Slice into rounds and place over hot steak, burgers, grilled chicken, pork chops, vegetables, potatoes, or bread so the butter melts into the food.",
              "image": 0,
              "ingredients": []
            }
          ],
          "name": "",
          "uid": -1
        }
      ]
