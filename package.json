{
  "name": "recipe-scrapers-crawlee",
  "version": "1.0.0",
  "type": "module",
  "description": "Danish recipe web crawler",
  "scripts": {
    "start": "tsx src/main.ts",
    "crawl:danish-jsonld": "tsx src/scripts/crawl-danish-jsonld.ts",
    "migration:status": "tsx src/scripts/migration-status.ts",
    "build": "tsc",
    "test": "vitest run",
    "test:all": "bash scripts/run_logged.sh test-run \"npm run build\" \"npm test\" \"npm run smoke:crawl\"",
    "crawl:all": "bash scripts/run_logged.sh full-crawl-run \"npm run build\" \"npm test\" \"npm run smoke:crawl\" \"npm start\"",
    "test:watch": "vitest",
    "report:runs": "tsx src/scripts/report-crawl-runs.ts",
    "smoke:crawl": "node --import tsx/esm src/scripts/smoke-crawl.ts",
    "postinstall": "playwright install --with-deps chromium"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "crawlee": "^3.16.0",
    "dotenv": "^17.3.1",
    "mongodb": "^7.1.1",
    "node-object-hash": "^3.1.1",
    "playwright": "^1.58.2",
    "proxy-chain": "^2.7.1",
    "socks-proxy-agent": "^8.0.5"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.1"
  }
}
